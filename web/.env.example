# All optional: defaults target Base Sepolia with Candide's public (keyless) endpoints.
# NEXT_PUBLIC_NODE_URL=https://sepolia.base.org
# NEXT_PUBLIC_BUNDLER_URL=https://api.candide.dev/public/v3/84532
# Browser default: <origin>/api/paymaster (Swissquote sponsorship policy, ADR-023).
# NEXT_PUBLIC_PAYMASTER_URL=
# Upstream paymaster used by the policy proxy and the relayer:
# PAYMASTER_UPSTREAM_URL=https://api.candide.dev/public/v3/84532
# SPONSORED_OPS_PER_MONTH=10

# Sanctions screening (ADR-022): extra mock addresses, optional Chainalysis key.
# SANCTIONS_EXTRA_ADDRESSES=0x...,0x...
# CHAINALYSIS_API_KEY=

# Mock Swissquote Guardian key (server-side). Share the same value across the team
# so wallets protected on one machine can be recovered from another.
# If unset, a key is generated once and kept in the store. Always set it on Vercel (ADR-020).
# SWISSQUOTE_GUARDIAN_PRIVATE_KEY=0x...

# Store (ADR-020). Unset locally: data goes to web/.data/db.json.
# On Vercel, connecting Upstash Redis (Storage → Marketplace) sets KV_REST_API_URL / KV_REST_API_TOKEN.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
