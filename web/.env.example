# All optional: defaults target Base Sepolia with Candide's public (keyless) endpoints.
# NEXT_PUBLIC_NODE_URL=https://sepolia.base.org
# NEXT_PUBLIC_BUNDLER_URL=https://api.candide.dev/public/v3/84532
# NEXT_PUBLIC_PAYMASTER_URL=https://api.candide.dev/public/v3/84532

# Mock Swissquote Guardian key (server-side). Share the same value across the team
# so wallets protected on one machine can be recovered from another.
# If unset, a key is generated once and stored in web/.data/db.json.
# SWISSQUOTE_GUARDIAN_PRIVATE_KEY=0x...
